  "intro": "Phase 1 · 字母与声音基础：先分清 Letter Name（字母名）与 Letter Sound（字母在单词里的声音）——这是中国学习者最易混淆的起点。",
  "tip": "⚠️ Letter Name ≠ Letter Sound。字母名是念 ABC 时的读音；字母音是它在单词里发出的声音。例：字母 A 的名字是 /eɪ/，但在 apple 里发 /æ/。",
  "letters": [
    { "ch": "A", "name": "/eɪ/", "sounds": [ { "ipa": "/æ/", "word": "apple", "zh": "苹果", "hint": "字母 A 最常见的发音" }, { "ipa": "/eɪ/", "word": "cake", "zh": "蛋糕", "hint": "a_e / ai 组合发字母名" } ] },
    { "ch": "B", "name": "/biː/", "sounds": [ { "ipa": "/b/", "word": "ball", "zh": "球", "hint": "清浊对比：/p/ 不震动，/b/ 震动" } ] },
    { "ch": "C", "name": "/siː/", "sounds": [ { "ipa": "/k/", "word": "cat", "zh": "猫", "hint": "C 后接 a/o/u 常发 /k/" }, { "ipa": "/s/", "word": "city", "zh": "城市", "hint": "C 后接 e/i/y 常发 /s/" } ] },
    { "ch": "D", "name": "/diː/", "sounds": [ { "ipa": "/d/", "word": "dog", "zh": "狗", "hint": "清浊对比：/t/ 不震动，/d/ 震动" } ] },
