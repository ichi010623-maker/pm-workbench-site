{
  "updatedAt": "2026-09-12",
  "intro": "Phase 4 · 自然拼读（Phonics × Spelling）：从拼写反推发音。每个单词按「字母 → 发音」拆开拼读，记住常见字母组合（Pattern）的读音规律，就能见词能读。",
  "howTo": "🔍 点击一个 Pattern（如 a_e）→ 看规律说明 → 逐个词拆解拼读：每个字母色块上标它的发音，∅ 表示不发音。点 🔊 听整词。",
  "cats": [
    {
      "id": "magic_e",
      "num": "A",
      "name": "Magic E · 魔法 e",
      "zh": "词尾不发音的 e 让前面的元音发「字母本音」（A→/eɪ/ I→/aɪ/ O→/əʊ/ U→/juː/）",
      "color": "#2563eb"
    },
    {
      "id": "vowel_team",
      "num": "B",
      "name": "元音字母组合",
      "zh": "两个元音一起发长音（ee/ea→/iː/ · ai/ay→/eɪ/ · oa→/əʊ/ · igh→/aɪ/）",
      "color": "#7c3aed"
    },
    {
      "id": "cons_team",
      "num": "C",
      "name": "辅音字母组合",
      "zh": "两个辅音合体发一个新音（sh→/ʃ/ · ch→/tʃ/ · th→/θ/ · ck→/k/）",
      "color": "#b45309"
    },
    {
      "id": "short_vowel",
      "num": "D",
      "name": "短元音 CVC",
      "zh": "辅音+元音+辅音（CVC）结构里元音发短音：a→/æ/ e→/e/ i→/ɪ/ o→/ɒ/ u→/ʌ/",
      "color": "#0891b2"
    }
  ],
